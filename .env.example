APP_NAME=ArabStarsSMM
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://yourapp.up.railway.app

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# Database (Railway Postgres plugin recommended)
DB_CONNECTION=pgsql
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
DB_SSLMODE=require

# Redis (Railway Redis plugin recommended)
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}

# Drivers
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
BROADCAST_DRIVER=log
FILESYSTEM_DISK=public

# Mail (configure your SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_email
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=ArabStarsSMM

# Payments (Stripe/PayPal)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=

# SMM Provider
SMMCPAN_API_URL=https://smmcpan.com/api/v2
SMMCPAN_API_KEY=

# Markup & Rewards
DEFAULT_MARKUP_PERCENT=20
REWARD_MINIMUM_USD=2

# Telegram (do NOT expose BOT TOKEN in frontend)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=https://yourapp.up.railway.app/telegram
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_REQUIRED_CHANNEL=@SubzoOfficial

# Other
APP_PORT=80
